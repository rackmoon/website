---
interface Props {
  name: keyof typeof ICONS;
  class?: string;
  /** Stroke width; product icons use 1.7, small interface icons 2 or more. */
  stroke?: number;
}

const ICONS = {
  billing:
    '<path d="M5 3h14v18l-2.33-1.5L14.33 21 12 19.5 9.67 21l-2.34-1.5L5 21Z"></path><path d="M9 8h6M9 12h6M9 16h3"></path>',
  kvm: '<rect x="3" y="3.5" width="18" height="7" rx="2"></rect><rect x="3" y="13.5" width="18" height="7" rx="2"></rect><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"></path>',
  hyperv:
    '<rect x="3" y="4" width="15" height="12" rx="2"></rect><path d="M3 8h15"></path><path d="M7 20h11a3 3 0 0 0 3-3V9"></path>',
  containers: '<path d="M21 7.5 12 3 3 7.5v9L12 21l9-4.5Z"></path><path d="m3 7.5 9 4.5 9-4.5M12 12v9"></path>',
  games:
    '<path d="M6.5 7h11A4.5 4.5 0 0 1 22 11.5v2a3.5 3.5 0 0 1-6.4 2L14.5 14h-5l-1.1 1.5A3.5 3.5 0 0 1 2 13.5v-2A4.5 4.5 0 0 1 6.5 7Z"></path><path d="M7 9.5v3M5.5 11h3"></path><path d="M15.5 10h.01M17.5 12h.01"></path>',
  monitor: '<path d="M3 12h4l2.5-6 5 12 2.5-6H21"></path>',
  sun: '<circle cx="12" cy="12" r="4"></circle><path d="M12 2.6v2.1M12 19.3v2.1M2.6 12h2.1M19.3 12h2.1M5.4 5.4l1.5 1.5M17.1 17.1l1.5 1.5M5.4 18.6l1.5-1.5M17.1 6.9l1.5-1.5"></path>',
  moon: '<path d="M19.6 14.8A8 8 0 0 1 9.2 4.4a8 8 0 1 0 10.4 10.4Z"></path>',
  ext: '<path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle>',
  globe:
    '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a13.5 13.5 0 0 1 0 18 13.5 13.5 0 0 1 0-18Z"></path>',
} as const;

const { name, class: className = 'pi', stroke = 1.7 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={ICONS[name]}
/>
