---
// x, y, size and one of four brightness steps.
const STARS: [number, number, number, number][] = [
  [60, 120, 2, 0],
  [140, 300, 2, 1],
  [230, 70, 3, 2],
  [330, 210, 2, 0],
  [420, 40, 2, 1],
  [520, 160, 3, 3],
  [640, 60, 2, 0],
  [700, 260, 2, 2],
  [760, 120, 3, 1],
  [860, 40, 2, 3],
  [930, 330, 2, 0],
  [1000, 90, 2, 1],
  [1080, 190, 3, 3],
  [1160, 60, 2, 2],
  [1230, 290, 2, 0],
  [1300, 140, 3, 1],
  [1380, 40, 2, 2],
  [1410, 360, 2, 0],
  [90, 470, 2, 2],
  [200, 560, 3, 1],
  [380, 520, 2, 0],
  [560, 610, 2, 3],
  [980, 560, 2, 1],
  [1120, 470, 3, 2],
  [1340, 520, 2, 0],
  [1250, 640, 2, 3],
  [40, 680, 2, 1],
  [820, 700, 2, 2],
];
---

<div class="sky" aria-hidden="true">
  <svg class="stars" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice">
    {STARS.map(([x, y, s, o]) => (
      <rect x={x} y={y} width={s} height={s} rx=".6" class={`star s${o}`} />
    ))}
  </svg>
</div>
