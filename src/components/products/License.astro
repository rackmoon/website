---
import Icon from '../Icon.astro';
import { copy, pathFor, type Lang } from '../../i18n';
import type { ProductKey } from '../../data/products';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const l = c.products.license;
---

<section class="sec sec-tight" id="pricing">
  <div class="wrap">
    <div class="price">
      <div class="price-copy">
        <p class="kicker">{l.k}</p>
        <h2>{l.h}</h2>
        <p class="sub">{l.p}</p>
        <div class="ctas">
          <a class="btn btn-p" href={pathFor(lang, 'about', '#contact')}>
            {c.contact}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
          <a class="btn btn-s" href={pathFor(lang, 'pricing')}>
            {c.pricing}
          </a>
        </div>
      </div>
      <div class="lic-card">
        <span class="mono-l">{l.cardK}</span>
        <ul class="lic">
          {c.products.items.map((item, i) => (
            <li>
              <span class="pc-ico">
                <Icon name={item.key as ProductKey} />
              </span>
              <b>{item.name}</b>
              <em>U{String(i + 1).padStart(2, '0')}</em>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
