---
import { copy, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const facts = copy[lang].home.facts;
---

<section class="facts" aria-label={lang === 'zh' ? '关键数字' : 'Facts'}>
  <div class="wrap">
    <div class="facts-in">
      {facts.map((f, i) => (
        <div class="fact">
          <span class="u">U{String(i + 1).padStart(2, '0')}</span>
          <b>{f.value}</b>
          <span class="fact-t">{f.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
