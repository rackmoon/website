---
import { copy, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = copy[lang].home.auto;
---

<section class="sec sec-alt" id="automation">
  <div class="wrap split split-r">
    <div class="sec-copy">
      <p class="kicker">{a.k}</p>
      <h2>{a.h}</h2>
      <p class="sub">{a.p}</p>
    </div>
    <div class="log">
      <div class="log-hd">
        <span>{a.log}</span>
        <span class="leds">
          <b class="led ok"></b>
        </span>
      </div>
      <div class="evs">
        {a.events.map((e) => (
          <div class={`ev ev-${e.state}`}>
            <span class="ev-t">{e.time}</span>
            <span class="ev-dot" />
            <span class="ev-n">{e.name}</span>
            <span class="ev-d">{e.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
