---
import Final from '../components/Final.astro';
import Detail from '../components/products/Detail.astro';
import Grid from '../components/products/Grid.astro';
import Hero from '../components/products/Hero.astro';
import Layout from '../layouts/Layout.astro';
import { copy, mailto, pathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
---

<Layout lang={lang} page="products" title={c.meta.products.title} description={c.meta.products.description}>
  <Hero lang={lang} />
  <Grid lang={lang} />
  {c.products.items.map((_, i) => (
    <Detail lang={lang} index={i} />
  ))}
  <Final
    h={c.home.final.h}
    p={c.home.final.p}
    ctas={[
      { label: c.contact, href: pathFor(lang, 'about', '#contact') },
      { label: c.about.contact.mailCta, href: mailto() },
    ]}
  />
</Layout>
