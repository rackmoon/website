---
import Final from '../components/Final.astro';
import Headline from '../components/Headline.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Stars from '../components/Stars.astro';
import LicenseCard from '../components/pricing/LicenseCard.astro';
import type { ProductKey } from '../data/products';
import Layout from '../layouts/Layout.astro';
import { EMAIL, copy, mailto, pathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const pr = c.pricingPage;
const notifySubject = (name: string) => (lang === 'zh' ? `价格咨询：${name}` : `Pricing: ${name}`);
---

<Layout lang={lang} page="pricing" title={c.meta.pricing.title} description={c.meta.pricing.description}>
  <section class="hero">
    <Stars />
    <div class="wrap p-hero-grid">
      <div class="hero-copy">
        <span class="pill">
          <i></i>
          {pr.pill}
        </span>
        <Headline lines={pr.h1} hi={pr.h1Hi} />
        <p class="lead">{pr.lead}</p>
        <div class="ctas">
          <a class="btn btn-p" href={mailto()}>
            {pr.emailCta}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
          <a class="btn btn-s" href={pathFor(lang, 'products')}>
            {c.explore}
          </a>
        </div>
        <p class="note">{pr.note.map((t, i) => (i ? [<i />, <span>{t}</span>] : <span>{t}</span>))}</p>
      </div>
      <div class="lic-vis" aria-hidden="true">
        <span class="em-glow"></span>
        <LicenseCard lang={lang} product="kvm" class="lk-back" />
        <LicenseCard lang={lang} product="billing" class="lk-front" />
      </div>
    </div>
  </section>

  <section class="sec sec-tight" id="list">
    <div class="wrap">
      <SectionHead kicker={pr.list.k} title={pr.list.h} sub={pr.list.p} />
      <div class="plist">
        <div class="pl-row pl-head" aria-hidden="true">
          <span></span>
          {pr.list.cols.map((t) => (
            <span>{t}</span>
          ))}
          <span></span>
        </div>
        {c.products.items.map((item) => (
          <div class="pl-row">
            <span class="pc-ico">
              <Icon name={item.key as ProductKey} />
            </span>
            <div class="pl-name">
              <b>{item.name}</b>
              <span>{item.desc}</span>
            </div>
            <span class="pl-type">{pr.list.type}</span>
            <span class="pl-price">{pr.list.price}</span>
            <a class="pl-cta" href={mailto(notifySubject(item.name))}>
              {pr.list.notify}
              <span class="arr" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-tight sec-alt">
    <div class="wrap">
      <SectionHead kicker={pr.includes.k} title={pr.includes.h} />
      <div class="incl">
        {pr.includes.items.map((item) => (
          <div class="incl-i">
            <span class="sq" />
            <b>{item.title}</b>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-tight" id="faq">
    <div class="wrap faq">
      <div>
        <SectionHead kicker={pr.faq.k} title={pr.faq.h} />
        <a class="faq-mail" href={mailto()}>
          {EMAIL}{' '}
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <div class="faq-list">
        {pr.faq.items.map((item) => (
          <div class="faq-q">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Final
    h={c.home.final.h}
    p={c.home.final.p}
    ctas={[
      { label: pr.emailCta, href: mailto() },
      { label: c.explore, href: pathFor(lang, 'products') },
    ]}
  />
</Layout>
